# Cloudflare Pages response headers for the Draftoryn SPA.
#
# Clerk (@clerk/expo) communicates with its Frontend API over fetch/XHR and
# navigates the top-level window for OAuth — it does not require framing or
# third-party scripts. If authentication breaks after tightening
# `connect-src`, add the exact Clerk Frontend API host shown in the browser
# console to that directive rather than widening `script-src`.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://*.clerk.com https://*.clerk.accounts.dev https://*.clerk.dev https://*.draftoryn.com https://*.workers.dev https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'self'; form-action 'self'; object-src 'none'; base-uri 'self'
  Cache-Control: no-store
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
