{
  "name": "draftoryn",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "tsx server/index.ts",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:engine": "tsc --noEmit -p tsconfig.node.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "node db/validate.mjs",
    "generate:seed": "node db/seed.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.12",
    "@clerk/expo": "^4.6.0",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@hono/node-server": "^2.1.1",
    "@neondatabase/serverless": "^0.10.4",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "docx": "^9.4.1",
    "expo": "^52.0.0",
    "expo-auth-session": "^57.0.10",
    "expo-constants": "~17.0.8",
    "expo-crypto": "^57.0.2",
    "expo-file-system": "^18.0.0",
    "expo-font": "~13.0.4",
    "expo-linking": "^7.0.0",
    "expo-router": "^4.0.0",
    "expo-secure-store": "^57.0.2",
    "expo-sharing": "^13.0.0",
    "expo-status-bar": "^2.0.0",
    "expo-web-browser": "^57.0.2",
    "hono": "^4.13.5",
    "js-yaml": "^4.1.0",
    "lucide-react-native": "^1.35.0",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "^15.11.1",
    "react-native-web": "^0.19.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
