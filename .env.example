# ===== Draftoryn environment =====
# Copy to .env and fill in. Client-safe keys are EXPO_PUBLIC_*.

# Clerk (authentication source of truth)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Draftoryn minimal server (secure AI access + privileged DB ops).
# Point the web/mobile app at the running server so generation + persistence work.
EXPO_PUBLIC_API_BASE=http://localhost:8787

# Server-only configuration
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
PORT=8787

# AI provider (server-side only; never exposed to the client).
# Any OpenAI-compatible Chat Completions endpoint works.
DRAFTORYN_AI_API_KEY=
DRAFTORYN_AI_BASE_URL=https://api.openai.com/v1
DRAFTORYN_AI_MODEL=gpt-4o
