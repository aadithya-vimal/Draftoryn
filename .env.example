# ===== Draftoryn environment =====
# Copy to .env and fill in. Client-safe keys are EXPO_PUBLIC_* ONLY.
# Placeholders only — never commit real credentials.

# Clerk (authentication source of truth)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Draftoryn API (secure AI access + privileged DB ops).
# Point the web/mobile app at the running server so generation + persistence work.
EXPO_PUBLIC_API_BASE=http://localhost:8787

# Server-only configuration
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
PORT=8787
NODE_ENV=development

# Server-side AI provider keys (optional; users may also bring their own keys
# in Settings, which stay on-device and are never stored server-side).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Local development ONLY. Enables the local dev identity when CLERK_SECRET_KEY
# is unset. NEVER set this in production (production fails closed to 401).
# ALLOW_DEV_AUTH=true

# Production CORS allowlist: exact origins, comma-separated.
# Requests from any other browser Origin receive 403.
# ALLOWED_ORIGINS=https://draftoryn.com,https://app.draftoryn.com
